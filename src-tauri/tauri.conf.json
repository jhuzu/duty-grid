{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DutyGrid",
  "version": "0.1.0",
  "identifier": "tw.gov.newtaipei.dutygrid",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DutyGrid",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../data/reference/banqiao_roads.db": "resources/banqiao_roads.db",
      "../標準化部署表.xlsx": "resources/standard_deployment_template.xlsx"
    }
  }
}
