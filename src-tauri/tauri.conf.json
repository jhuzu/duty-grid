{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "勤務人力規劃系統",
  "version": "0.1.0",
  "identifier": "tw.gov.newtaipei.dutygrid",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "勤務人力規劃系統",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 16 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://wmts.nlsc.gov.tw https://tile.openstreetmap.org; img-src 'self' asset: http://asset.localhost blob: data: https://wmts.nlsc.gov.tw https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../data/reference/banqiao_roads.db": "resources/banqiao_roads.db",
      "../標準化部署表.xlsx": "resources/standard_deployment_template.xlsx"
    }
  }
}
